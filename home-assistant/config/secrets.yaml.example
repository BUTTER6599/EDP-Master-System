# Append these to Home Assistant's /config/secrets.yaml.
# Never commit the real secrets.yaml.
#
# The two URLs are the SAME deployed Apps Script web app with different
# tokens. The token decides the scope, so a display that only holds the
# public URL cannot request private data.

edp_bridge_base: "https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec"
edp_bridge_key_public: "PASTE_VALUE_OF_BRIDGE_TOKEN"
edp_bridge_key_private: "PASTE_VALUE_OF_BRIDGE_TOKEN_PRIVATE"
